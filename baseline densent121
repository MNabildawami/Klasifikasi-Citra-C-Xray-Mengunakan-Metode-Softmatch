a":{"id":"vKQdAz0Ilbs0"}},{"cell_type":"code","source":["# ==============================================================================\n","# FASE 2: ATURAN PRAPEMROSESAN & ARSITEKTUR DATASET\n","# ==============================================================================\n","print(\"⚙️ MENYIAPKAN ATURAN PREPROCESSING...\")\n","\n","# 1. Normalisasi standar ImageNet\n","norm = transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n","\n","# 2. Transformasi Data Train (Hanya Weak Augmentation)\n","tf_train = transforms.Compose([\n","    transforms.Resize((IMG_SIZE_RESIZE, IMG_SIZE_RESIZE)),\n","    transforms.RandomRotation(degrees=5),\n","    transforms.RandomAffine(degrees=0, translate=(0.02, 0.02)),\n","    transforms.CenterCrop(IMG_SIZE_CROP),\n","    transforms.ToTensor(),\n","    norm\n","])\n","\n","# 3. Transformasi Data Validation & Test\n","tf_test = transforms.Compose([\n","    transforms.Resize((IMG_SIZE_CROP, IMG_SIZE_CROP)),\n","    transforms.ToTensor(),\n","    norm\n","])\n","\n","# 4. Blueprint Dataset Supervised Murni\n","class CXR_Baseline_Dataset(Dataset):\n","    def __init__(self, file_paths, labels, transform=None):\n","        self.file_paths = file_paths\n","        self.labels = labels\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.file_paths)\n","\n","    def __getitem__(self, idx):\n","        # Memaksa gambar menjadi format RGB\n","        img = Image.open(self.file_paths[idx]).convert('RGB')\n","        if self.transform:\n","            img = self.transform(img)\n","        return img, self.labels[idx]\n","\n","print(\"✅ FASE 2 SELESAI: Aturan Preprocessing dan Dataset dikunci!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0z9E3PMAeqvg","executionInfo":{"status":"ok","timestamp":1777741346402,"user_tz":-420,"elapsed":18,"user":{"displayName":"M.Nabil Dawami","userId":"07685946931770740852"}},"outputId":"b657206a-507a-4018-b3f4-6c99f0898437"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["⚙️ MENYIAPKAN ATURAN PREPROCESSING...\n","✅ FASE 2 SELESAI: Aturan Preprocessing dan Dataset dikunci!\n"]}]},{"cell_type":"markdown","source":["# Fase 3 - Prapemrosesan & Eksekusi Splitting"],"metadata":{"id":"WvLc3b6NfnHz"}},{"cell_type":"code","source":["# ==============================================================================\n","# FASE 3: BACA DATA DARI DISK LOKAL COLAB & DATALOADER (SUPER CEPAT)\n","# ==============================================================================\n","import shutil\n","\n","print(\"⚡ MEMINDAHKAN DATA DARI GOOGLE DRIVE KE DISK LOKAL COLAB...\")\n","\n","# Path asli di Google Drive\n","DRIVE_SPLIT_DIR = '/content/drive/MyDrive/0.TUGAS AKHIR (TA)/Project hasil/BACKUP_HASIL_PENELITIAN_SOFTMATCH/BUKTI_FISIK_1_SPLIT_UTAMA'\n","\n","# Path lokal di mesin Colab (Jauh lebih cepat dibaca oleh PyTorch)\n","LOCAL_SPLIT_DIR = '/content/DATASET_LOKAL_SPLIT'\n","\n","# 1. Proses Copy ke Lokal (Hanya jalan sekali)\n","if not os.path.exists(LOCAL_SPLIT_DIR):\n","    print(\"⏳ Sedang meng-copy data ke memori lokal Colab...\")\n","    print(\"   (Tunggu sebentar, pengorbanan waktu 1-2 menit di awal akan menghemat berjam-jam waktu training!)\")\n","    shutil.copytree(DRIVE_SPLIT_DIR, LOCAL_SPLIT_DIR)\n","    print(\"✅ Copy selesai!\")\n","else:\n","    print(\"✅ Data sudah siap di memori lokal Colab.\")\n","\n","def get_paths_and_labels(base_dir, split_name):\n","    paths, labels = [], []\n","    split_dir = os.path.join(base_dir, split_name)\n","    if not os.path.exists(split_dir):\n","        print(f\"❌ ERROR: Folder {split_dir} tidak ditemukan!\")\n","        return paths, labels\n","\n","    for c in CLASSES:\n","        class_dir = os.path.join(split_dir, c)\n","        if os.path.exists(class_dir):\n","            for f in os.listdir(class_dir):\n","                if f.lower().endswith(('.png', '.jpg', '.jpeg')):\n","                    paths.append(os.path.join(class_dir, f))\n","                    labels.append(class_to_idx[c])\n","    return paths, labels\n","\n","# 2. Ambil path gambar dari disk lokal\n","print(\"\\n🔍 Membaca path gambar dari Disk Lokal Colab...\")\n","train_paths, train_labels = get_paths_and_labels(LOCAL_SPLIT_DIR, \"train\")\n","val_paths, val_labels = get_paths_and_labels(LOCAL_SPLIT_DIR, \"val\")\n","test_paths, test_labels = get_paths_and_labels(LOCAL_SPLIT_DIR, \"test\")\n","\n","print(f\"   -> Train : {len(train_paths)} gambar\")\n","print(f\"   -> Val   : {len(val_paths)} gambar\")\n","print(f\"   -> Test  : {len(test_paths)} gambar\")\n","\n","# 3. Masukkan ke DataLoader (Dengan turbo: num_workers & pin_memory)\n","train_loader = DataLoader(CXR_Baseline_Dataset(train_paths, train_labels, transform=tf_train),\n","                          batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)\n","val_loader = DataLoader(CXR_Baseline_Dataset(val_paths, val_labels, transform=tf_test),\n","                        batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n","test_loader = DataLoader(CXR_Baseline_Dataset(test_paths, test_labels, transform=tf_test),\n","                         batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n","\n","print(\"\\n✅ FASE 3 SELESAI: Data siap dimasukkan ke model dengan kecepatan maksimal!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7Uy77HZzfCDG","executionInfo":{"status":"ok","timestamp":1777741499363,"user_tz":-420,"elapsed":148847,"user":{"displayName":"M.Nabil Dawami","userId":"07685946931770740852"}},"outputId":"eeabea92-a19a-4961-9ea1-1b20efb6a43f"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["⚡ MEMINDAHKAN DATA DARI GOOGLE DRIVE KE DISK LOKAL COLAB...\n","⏳ Sedang meng-copy data ke memori lokal Colab...\n","   (Tunggu sebentar, pengorbanan waktu 1-2 menit di awal akan menghemat berjam-jam waktu training!)\n","✅ Copy selesai!\n","\n","🔍 Membaca path gambar dari Disk Lokal Colab...\n","   -> Train : 3659 gambar\n","   -> Val   : 523 gambar\n","   -> Test  : 1046 gambar\n","\n","✅ FASE 3 SELESAI: Data siap dimasukkan ke model dengan kecepatan maksimal!\n"]}]},{"cell_type":"markdown","source":["# Fase 4 - Setup Arsitektur DenseNet121 & Optimizer"],"metadata":{"id":"we8jjIFefu1V"}},{"cell_type":"code","source":["# ==============================================================================\n","# FASE 4: ARSITEKTUR MODEL BASELINE & OPTIMIZER\n","# ==============================================================================\n","print(\"🧠 MEMBANGUN OTAK AI (DENSENET-121 MURNI)...\")\n","\n","# 1. Panggil Arsitektur DenseNet121\n","model = models.densenet121(pretrained=True)\n","\n","# 2. Modifikasi Classifier untuk 3 Kelas\n","num_ftrs = model.classifier.in_features\n","model.classifier = nn.Linear(num_ftrs, NUM_CLASSES)\n","\n","# 3. Pindahkan Model ke Hardware Utama\n","model = model.to(DEVICE)\n","\n","# 4. Siapkan Penilai (Criterion) dan Pengoptimasi (Optimizer)\n","criterion = nn.CrossEntropyLoss()\n","optimizer = optim.SGD(model.parameters(), lr=LEARNING_RATE, momentum=MOMENTUM, weight_decay=WEIGHT_DECAY)\n","\n","print(\"✅ FASE 4 SELESAI: Model dan Optimizer sudah siap!\")"],"metadata":{"id":"_n42zFRtf3DV","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1777741502828,"user_tz":-420,"elapsed":708,"user":{"displayName":"M.Nabil Dawami","userId":"07685946931770740852"}},"outputId":"727b7b40-2d09-4869-8afe-6ec6d0b6d96f"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["🧠 MEMBANGUN OTAK AI (DENSENET-121 MURNI)...\n","Downloading: \"https://download.pytorch.org/models/densenet121-a639ec97.pth\" to /root/.cache/torch/hub/checkpoints/densenet121-a639ec97.pth\n"]},{"output_type":"stream","name":"stderr","text":["100%|██████████| 30.8M/30.8M [00:00<00:00, 201MB/s]\n"]},{"output_type":"stream","name":"stdout","text":["✅ FASE 4 SELESAI: Model dan Optimizer sudah siap!\n"]}]},{"cell_type":"markdown","source":["# Fase 5 - Proses Training (Supervised Murni)"],"metadata":{"id":"RLipOf9bf09y"}},{"cell_type":"code","source":["# ==============================================================================\n","# FASE 5: TRAINING LOOP MURNI\n","# ==============================================================================\n","print(\"🔥 MEMULAI TRAINING BASELINE...\\n\")\n","\n","best_val_acc = 0.0\n","train_losses, val_losses, train_accs, val_accs = [], [], [], []\n","best_model_path = os.path.join(DIR_HASIL_BASELINE, 'densenet121_baseline_best.pth')\n","\n","for epoch in range(TOTAL_EPOCHS):\n","    start_time = time.time()\n","\n","    # ---------------------------------------------------------\n","    # A. FASE LATIHAN (TRAIN)\n","    # ---------------------------------------------------------\n","    model.train()\n","    running_loss, correct_train, total_train = 0.0, 0, 0\n","    for inputs, labels in tqdm(train_loader, desc=f\"Epoch {epoch+1}/{TOTAL_EPOCHS} [Train]\", leave=False):\n","        inputs, labels = inputs.to(DEVICE), labels.to(DEVICE)\n","\n","        optimizer.zero_grad()\n","        outputs = model(inputs)\n","        loss = criterion(outputs, labels)\n","\n","        loss.backward()\n","        optimizer.step()\n","\n","        running_loss += loss.item() * inputs.size(0)\n","        _, predicted = outputs.max(1)\n","        total_train += labels.size(0)\n","        correct_train += predicted.eq(labels).sum().item()\n","\n","    epoch_train_loss = running_loss / total_train\n","    epoch_train_acc = correct_train / total_train\n","\n","    # ---------------------------------------------------------\n","    # B. FASE UJIAN (VALIDATION)\n","    # ---------------------------------------------------------\n","    model.eval()\n","    running_val_loss, correct_val, total_val = 0.0, 0, 0\n","    with torch.no_grad():\n","        for inputs, labels in tqdm(val_loader, desc=f\"Epoch {epoch+1}/{TOTAL_EPOCHS} [Val]\", leave=False):\n","            inputs, labels = inputs.to(DEVICE), labels.to(DEVICE)\n","\n","            outputs = model(inputs)\n","            loss = criterion(outputs, labels)\n","\n","            running_val_loss += loss.item() * inputs.size(0)\n","            _, predicted = outputs.max(1)\n","            total_val += labels.size(0)\n","            correct_val += predicted.eq(labels).sum().item()\n","\n","    epoch_val_loss = running_val_loss / total_val\n","    epoch_val_acc = correct_val / total_val\n","\n","    # Simpan Histori\n","    train_losses.append(epoch_train_loss); val_losses.append(epoch_val_loss)\n","    train_accs.append(epoch_train_acc); val_accs.append(epoch_val_acc)\n","\n","    time_elapsed = time.time() - start_time\n","    print(f\"Epoch [{epoch+1}/{TOTAL_EPOCHS}] - {time_elapsed:.0f}s | \"\n","          f\"Train Loss: {epoch_train_loss:.4f} | Acc: {epoch_train_acc*100:.2f}% | \"\n","          f\"Val Loss: {epoch_val_loss:.4f} | Acc: {epoch_val_acc*100:.2f}%\")\n","\n","    # Simpan bobot terbaik\n","    if epoch_val_acc > best_val_acc:\n","        best_val_acc = epoch_val_acc\n","        torch.save(model.state_dict(), best_model_path)\n","        print(f\"   ⭐ Model terbaik disimpan! (Akurasi Val: {best_val_acc*100:.2f}%)\")\n","\n","print(f\"\\n✅ FASE 5 SELESAI: Training Rampung!\")"],"metadata":{"id":"CJ7ck27qgnv3","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1777742392579,"user_tz":-420,"elapsed":862985,"user":{"displayName":"M.Nabil Dawami","userId":"07685946931770740852"}},"outputId":"65ac3ff3-1e6b-4798-a6b0-f239caf5e45d"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["🔥 MEMULAI TRAINING BASELINE...\n","\n"]},{"output_type":"stream","name":"stderr","text":[]},{"output_type":"stream","name":"stdout","text":["Epoch [1/40] - 24s | Train Loss: 0.2620 | Acc: 89.86% | Val Loss: 0.1165 | Acc: 95.98%\n","   ⭐ Model terbaik 